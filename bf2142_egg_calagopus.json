  "scripts": {
    "installation": {
      "container": "ghcr.io/pelican-eggs/yolks:debian",
      "entrypoint": "/bin/bash",
      "content": "#!/bin/bash\n#\n##---------------------------------------------\n## henwoodenator's BF2142 Calagopus install script\n##---------------------------------------------\n## GAME:        Battlefield 2142 w/ OpenSpy patch\n## DATE:        Nov 2026\n## PLATFORM:    Calagopus Panel \n## AUTHOR:      henwoodenator / drPyro / mister_apocalypse\n## CONTAINER:   Installer container ghcr.io/pelican-eggs/yolks:debian\n##              Running container ghcr.io/pelican-eggs/steamcmd:debian\n#\n## DESCRIPTION: BF2142 Install script for Calagopus Panel. Should also work with Pelican / Pterodactyl \n#               but untested. Downloads BF2142 linux dedicated server files. Not sure if it needs \n#               reclamation mod / maps yet. \n#\n## CREDITS:     Self\n##---------------------------------------------\n#\n## Uncomment the below line if you want full verbose console output\nset -x\n#\n##---------------------------------------------\n## INSTALL PREREQUSITES ##\n##---------------------------------------------\n#apt install bzip2\ncd /mnt/server\n##---------------------------------------------\n## DOWNLOAD & UNPACK 1.50 SERVER FILES ##\n##---------------------------------------------\necho 'Downloading and installing 1.50 linux server files'\nwget -O bf2142-server.tar.gz https://github.com/henwoodenator/Calagopus_Eggs/raw/refs/heads/main/bf2142/bf2142-linuxded-1.10.112.tar.gz\ntar -xzf bf2142-server.tar.gz\ncp -r \\\n    bf2142-linuxded-1.10.112/admin \\\n    bf2142-linuxded-1.10.112/adminutils \\\n    bf2142-linuxded-1.10.112/mods \\\n    bf2142-linuxded-1.10.112/python \\\n    bf2142-linuxded-1.10.112/readmes \\\n    bf2142-linuxded-1.10.112/bin \\\n    bf2142-linuxded-1.10.112/pylib-2.3.4.zip \\\n    bf2142-linuxded-1.10.112/rotate_demo.cfg \\\n    bf2142-linuxded-1.10.112/lowercaseDir.py \\\n    bf2142-linuxded-1.10.112/start.sh \\\n    ./\n## Install missing libraries so I dont have to make a custom yolk / image\nwget https://ftp.debian.org/debian/pool/main/n/ncurses/libtinfo5_6.4-4_amd64.deb\nwget https://ftp.debian.org/debian/pool/main/n/ncurses/libncurses5_6.4-4_amd64.deb\ndpkg-deb -x libtinfo5_*.deb extracted\ndpkg-deb -x libncurses5_*.deb extracted2\ncp extracted/lib/x86_64-linux-gnu/libtinfo.so.5* /mnt/server/bin/amd-64/\ncp extracted2/lib/x86_64-linux-gnu/libncurses.so.5* /mnt/server/bin/amd-64/\n##---------------------------------------------\n## INSTALL PUNKBUSTER BINARIES ##\n##---------------------------------------------\ncp -r bf2142-linuxded-1.10.112/pb_amd-64/* ./\n##---------------------------------------------\n## REMOVE EXTRA FILES ##\n##---------------------------------------------\nrm -r bf2142-linuxded-1.10.112 bf2142-server.tar.gz\nrm -r libncurses5_*.deb libtinfo5_*.deb\nrm -r extracted extracted2\n##---------------------------------------------\n## Downloading Reclamation MapPack ##\n##---------------------------------------------\n#echo 'Downloading Reclamation Map Pack - Please wait (6GB)'\n#curl -L -A \"Mozilla/5.0\" \\\n#     -o map_pack.zip \\\n#     \"https://www.moddb.com/downloads/mirror/287584/134/efb622b782f67fbe36d9daf2be6559b8\"\n#if ! unzip -t map_pack.zip >/dev/null 2>&1; then\n#    echo \"Download failed\"\n#    exit 1\n#fi\n#curl -o map_pack.zip https://www.moddb.com/downloads/mirror/287584/134/efb622b782f67fbe36d9daf2be6559b8\n#unzip map_pack.zip\necho 'Installation Complete'"
    }
  },
